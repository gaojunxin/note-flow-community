{
  "name": "@note-flow/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Note Flow community local core candidate; publication gate pending",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --strict --skipLibCheck --target ES2022 --module ESNext --moduleResolution Bundler --resolveJsonModule --lib ES2022,DOM src/community/index.ts src/community/indexedDbHost.ts src/community/nativeLocalHost.ts"
  },
  "exports": {
    ".": "./src/community/index.ts",
    "./community": "./src/community/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./contracts/sync": "./src/contracts/sync.ts",
    "./local-storage-web": "./src/community/indexedDbHost.ts",
    "./reminders": "./src/reminders.ts",
    "./local-storage-native": "./src/community/nativeLocalHost.ts",
    "./vault": "./src/vault.ts",
    "./task-recurrence": "./src/community/taskRecurrencePreview.ts",
    "./task-schedule": "./src/taskSchedule.ts",
    "./totp": "./src/totp.ts",
    "./search": "./src/search.ts",
    "./note-classification": "./src/noteClassification.ts",
    "./workspace": "./src/workspace.ts",
    "./note-body": "./src/noteBody.ts",
    "./native-core": "./src/nativeCore.ts",
    "./app-info": "./src/appInfo.ts",
    "./ai-learning": "./src/aiLearning.ts",
    "./imported-note-links": "./src/importedNoteLinks.ts",
    "./attachment-text": "./src/attachmentText.ts",
