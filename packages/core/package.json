    "./workspace-unlock-session": "./src/workspaceUnlockSession.ts",
    "./focus-records": "./src/focusRecords.ts",
    "./sync-compatibility": "./src/syncCompatibility.ts",
    "./remote-note-history": "./src/contracts/remoteNoteHistory.ts",
    "./sync-execution-policy": "./src/syncExecutionPolicy.ts",
    "./contracts/knowledge-cards": "./src/contracts/knowledgeCards.ts",
    "./daily-culture": "./src/dailyCulture.ts",
    "./reader-find": "./src/readerFind.ts",
    "./natural-name-sort": "./src/naturalNameSort.ts",
    "./sync-presentation": "./src/syncPresentation.ts"
  },
  "dependencies": {
    "idb": "8.0.3",
    "yjs": "13.6.27"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
