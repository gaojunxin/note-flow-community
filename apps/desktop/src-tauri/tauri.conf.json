{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteFlow Community",
  "version": "0.13.2",
  "identifier": "com.noteflow.community.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev:community",
      "cwd": ".."
    },
    "devUrl": "http://localhost:5176/community.html",
    "frontendDist": "../dist-community"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "迹语社区版",
        "url": "community.html",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'self'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": [
      "deb"
    ],
    "shortDescription": "Local notes and tasks",
    "category": "Productivity"
  }
}
